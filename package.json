{
  "name": "tor-event-calendar-ai",
  "version": "0.3.0",
  "description": "nambli account-scoped calendar MCP plugin and optional local CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tor-calendar": "src/cli.mjs"
  },
  "files": [
    "src",
    "skills",
    "ecosystems",
    "contracts",
    ".codex-plugin",
    ".claude-plugin",
    "LICENSE",
    "README.md",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    "assets",
    "ecosystems/claude-code",
    "scripts/claude_code.py",
    "scripts/test_claude_code.py",
    "scripts/package.py",
    "scripts/test_package.py",
    "scripts/test.mjs",
    "scripts/test-download.mjs"
  ],
  "dependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "package": "python scripts/package.py",
    "validate:claude-code": "python scripts/claude_code.py validate",
    "test:claude-code": "python scripts/test_claude_code.py",
    "build:claude-code": "python scripts/claude_code.py build",
    "probe:claude-code": "python scripts/claude_code.py probe"
  }
}
